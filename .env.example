# Yayından önce tüm işletme bilgilerini doğrulayın.
# Gerçek HTTPS alan adı; yol veya sorgu eklemeyin.
NEXT_PUBLIC_SITE_URL=
# Ülke koduyla rakamlar: Türkiye için 90 ile başlar.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_WORKING_HOURS=
NEXT_PUBLIC_MAP_LATITUDE=
NEXT_PUBLIC_MAP_LONGITUDE=
# Test ortamlarında true: arama motorlarına kapalı.
SITE_PREVIEW=false
# Yayın derlemesinde eksik ayarlar varsa durdurur.
REQUIRE_PUBLISH_CONFIG=1
